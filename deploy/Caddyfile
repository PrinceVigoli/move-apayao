{$LANDING_DOMAIN} {
  handle_path /downloads/* {
    root * /srv/downloads
    header Content-Disposition "attachment"
    header Cache-Control "public, max-age=300"
    file_server
  }

  handle {
    reverse_proxy landing:8080
  }
}

{$WWW_DOMAIN} {
  redir https://{$LANDING_DOMAIN}{uri} permanent
}

{$DASHBOARD_DOMAIN} {
  reverse_proxy dashboard:8080
}

{$DOCUMENTATION_DOMAIN} {
  reverse_proxy documentation:8080
}

{$API_DOMAIN} {
  reverse_proxy api:5000
}
