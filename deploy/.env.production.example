# Copy to deploy/.env.production on the VPS. Never commit the real file.

# Public DNS names. Create A/AAAA records pointing to the VPS first.
LANDING_DOMAIN=moveapayao.example.gov.ph
WWW_DOMAIN=www.moveapayao.example.gov.ph
DASHBOARD_DOMAIN=admin.moveapayao.example.gov.ph
DOCUMENTATION_DOMAIN=docs.moveapayao.example.gov.ph
API_DOMAIN=api.moveapayao.example.gov.ph

# Database and Redis. Use long random values; URL-encode special characters
# when placing them inside DATABASE_URL or REDIS_URL.
POSTGRES_USER=move_apayao
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=move_apayao
DATABASE_URL=postgresql://move_apayao:replace-with-url-encoded-password@db:5432/move_apayao
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-url-encoded-password@redis:6379

PORT=5000
JWT_SECRET=replace-with-at-least-48-random-characters
CORS_ALLOWED_ORIGINS=https://moveapayao.example.gov.ph,https://admin.moveapayao.example.gov.ph,https://docs.moveapayao.example.gov.ph
TRUST_PROXY_HOPS=1

# Server-only Google keys. Never use the browser or Android key here.
GOOGLE_MAPS_SERVER_API_KEY=replace-with-restricted-server-key
GOOGLE_PLACES_API_KEY=replace-with-restricted-server-key

# Brevo SMTP relay or another production SMTP provider.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-login
SMTP_PASS=replace-with-smtp-key
SMTP_FROM=MOVE Apayao <no-reply@moveapayao.example.gov.ph>
PASSWORD_RESET_URL_BASE=https://moveapayao.example.gov.ph/reset-password

# Internal GIS. This token is shared only by api and gis containers.
GIS_SERVICE_URL=http://gis:5100
GIS_SERVICE_TOKEN=replace-with-at-least-48-random-characters
GIS_RAW_POINT_RETENTION_DAYS=180

# Point-to-point pilot boundary.
PILOT_BOOKING_MODE=point_to_point
PILOT_SERVICE_AREA_ENABLED=true
PILOT_SERVICE_AREA_LABEL=Pudtol-Luna pilot area
PILOT_SERVICE_AREA_CENTER_LAT=18.283
PILOT_SERVICE_AREA_CENTER_LON=121.372
PILOT_SERVICE_AREA_RADIUS_KM=20
PILOT_MIN_TRIP_DISTANCE_KM=0.2

# Trip and tracking safety.
IOT_PRIMARY_TTL_MS=45000
IOT_MAX_BACKFILL_AGE_HOURS=168
PUBLIC_VEHICLE_LOCATION_TTL_MS=300000
TRIP_PROXIMITY_ENFORCEMENT=true
TRIP_LOCATION_MAX_AGE_MS=180000
TRIP_PICKUP_RADIUS_M=750
TRIP_DROPOFF_RADIUS_M=1500
TRIP_MIN_DURATION_SECONDS=30

# Capacity and reporting.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
PASSWORD_HASH_CONCURRENCY=2
REPORTING_TIME_ZONE=Asia/Manila
REPORTING_UTC_OFFSET=+08:00
LOG_LEVEL=info

# Public browser/build settings.
GOOGLE_MAPS_BROWSER_API_KEY=replace-with-http-referrer-restricted-browser-key
SERVICE_OPERATOR=Department of Science and Technology (DOST)
SUPPORT_EMAIL=
CONTACT_DETAILS_PENDING=true
PRIVACY_EMAIL=
SUPPORT_PHONE=replace-with-public-support-number
OFFICE_ADDRESS=Apayao, Philippines
SUPPORT_HOURS=To be confirmed
PASSENGER_ANDROID_URL=https://moveapayao.com/downloads/move-apayao-passenger.apk
DRIVER_ANDROID_URL=https://moveapayao.com/downloads/move-apayao-driver.apk
STORES_LIVE=true
