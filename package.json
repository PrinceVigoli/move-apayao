{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "scripts": {
    "admin:set-password": "pnpm --filter @workspace/scripts run admin:set-password",
    "user:set-password": "pnpm --filter @workspace/scripts run user:set-password",
    "staff:set-role": "pnpm --filter @workspace/scripts run staff:set-role",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "security:test": "node scripts/security/image-size-regression.mjs",
    "test": "pnpm -r --if-present run test",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2",
    "@esbuild/win32-x64": "0.28.2",
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "@rollup/rollup-win32-x64-msvc": "^4.62.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.2",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.2",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
