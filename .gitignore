# Dependencies
node_modules/
.pnpm-store/

# Env files (never commit secrets)
.env
.env.local
.env.*.local

# Firebase / Google service credentials
# Provide app client configs to EAS as GOOGLE_SERVICES_JSON file variables.
artifacts/mobile/google-services.json
artifacts/driver/google-services.json
*firebase*service-account*.json
*fcm*service-account*.json
*-firebase-adminsdk-*.json
firebase-adminsdk-*.json

# Android signing credentials must stay in EAS/local secret storage.
*.jks
*.keystore
local-secrets/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native build output (if prebuild/eas generates these)
artifacts/mobile/android/
artifacts/mobile/ios/
*.apk
*.aab

# Build output
build/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
