FROM node:22.23.1-slim AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @workspace/gis-service... run build

FROM node:22.23.1-slim AS runner
WORKDIR /app
ENV NODE_ENV=production PORT=5100 HOST=0.0.0.0
COPY --from=build /repo/artifacts/gis-service/dist ./dist
USER node
EXPOSE 5100
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:5100/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
