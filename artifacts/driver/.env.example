# Runtime API origin. Use your computer's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
EXPO_PUBLIC_LEGAL_BASE_URL=https://moveapayao.com
EXPO_PUBLIC_SUPPORT_EMAIL=support@moveapayao.com

# Native build variables consumed by app.config.js. Store production values as
# EAS environment secrets and restrict each key to this app/platform.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Path supplied automatically when GOOGLE_SERVICES_JSON is an EAS file variable.
# For a local native build, use ./google-services.json.
GOOGLE_SERVICES_JSON=./google-services.json
