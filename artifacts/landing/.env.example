# Browser key restricted to Maps JavaScript API and landing-site HTTP referrers.
# This must not be the server-side Places/Routes key.
VITE_GOOGLE_MAPS_BROWSER_API_KEY=
# Permanent HTTPS origin used for canonical links, social cards, robots, and sitemap.
VITE_SITE_URL=https://moveapayao.gov.ph
VITE_DOCUMENTATION_URL=https://documentation.moveapayao.gov.ph
VITE_FACEBOOK_URL=
VITE_SUPPORT_EMAIL=lgupudtol1@gmail.com
VITE_PRIVACY_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SERVICE_OPERATOR=Municipal Government of Pudtol
VITE_OFFICE_ADDRESS=Pudtol Municipal Hall, Poblacion, Pudtol, Apayao 3812
VITE_SUPPORT_HOURS=Monday to Friday, during government office hours

# Pilot build links or future store listings. Keep VITE_STORES_LIVE=false until
# both Android listings are public; configured preview URLs still work as pilot links.
VITE_STORES_LIVE=false
VITE_PASSENGER_ANDROID_URL=
VITE_PASSENGER_IOS_URL=
VITE_DRIVER_ANDROID_URL=
VITE_DRIVER_IOS_URL=

# Leave blank when the landing site and API share an origin. For separate
# deployments use the public API origin, e.g. https://api.moveapayao.ph.
VITE_API_URL=
