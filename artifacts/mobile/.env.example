# Runtime API origin. Use your computer's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# Native build variables consumed by app.config.js. Store production values as
# EAS environment secrets and restrict each key to this app/platform.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
