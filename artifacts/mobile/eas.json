{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "node": "22.23.1",
      "pnpm": "11.17.0",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "environment": "preview",
      "node": "22.23.1",
      "pnpm": "11.17.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.moveapayao.com"
      },
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "node": "22.23.1",
      "pnpm": "11.17.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.moveapayao.com"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
