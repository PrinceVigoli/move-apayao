# This service is internal. The browser must never receive this token.
PORT=5100
HOST=127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/move_apayao
GIS_SERVICE_TOKEN=generate-a-long-random-secret

# Raw GPS samples older than this are deleted daily. Aggregated candidates and
# audit events are retained. Allowed range: 30-730 days.
GIS_RAW_POINT_RETENTION_DAYS=180
