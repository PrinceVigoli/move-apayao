{
  "name": "@workspace/gis-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ./build.mjs",
    "dev": "pnpm run build && node --env-file-if-exists=../api-server/.env.local --env-file-if-exists=../api-server/.env --enable-source-maps ./dist/index.mjs",
    "start": "node --env-file-if-exists=../api-server/.env.local --env-file-if-exists=../api-server/.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2"
  }
}
