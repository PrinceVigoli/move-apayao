# Copy this file to .env.local (or export these before running `pnpm dev`)

# Required to boot
PORT=5000

# Postgres connection (required for any DB-backed route: /api/loops, /api/trips, etc.)
# Local example if you run Postgres via Docker (see SETUP_GUIDE.md §3.3):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/move_apayao

# Optional — Redis powers live driver location (geo) features.
# If unset, the server still boots; Redis-backed routes become no-ops.
REDIS_URL=redis://localhost:6379

# Redis is required for production matching, location streaming, and shared
# rate limiting. Without it the API starts only for limited local work and its
# readiness endpoint reports degraded.

# ── Authentication (required) ────────────────────────────────────────────────
# Signing key for access tokens. MUST be at least 32 characters — the server
# refuses to boot otherwise, because a weak or defaulted key would let anyone
# forge an admin token. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Password reset email (optional) ──────────────────────────────────────────
# Optional for local development but required in production. Reset links and
# tokens are never written to server logs. Brevo supports port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MOVE Apayao <no-reply@example.com>"

# Where the reset link in that email should point. Must be a page that reads
# ?token=... and calls POST /api/auth/reset-password.
PASSWORD_RESET_URL_BASE=http://localhost:5173/reset-password

# Optional integrations
OPENWEATHERMAP_API_KEY=
READER_API_KEY=
# Server-only keys. Enable Places API for search and Routes API for road
# distance/polyline. Keep these out of VITE_/EXPO_PUBLIC_ variables.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=

# Point-to-point pilot boundary. Both pickup and destination must be within
# this radius. Defaults cover the Pudtol-Payanan-Luna pilot corridor.
PILOT_SERVICE_AREA_ENABLED=true
PILOT_SERVICE_AREA_LABEL="Pudtol-Luna pilot area"
PILOT_SERVICE_AREA_CENTER_LAT=18.283
PILOT_SERVICE_AREA_CENTER_LON=121.372
PILOT_SERVICE_AREA_RADIUS_KM=20
PILOT_MIN_TRIP_DISTANCE_KM=0.2

# Required safeguards in production. Local simulations may disable these when
# no real driver GPS source is available.
TRIP_PROXIMITY_ENFORCEMENT=false
TRIP_LOCATION_MAX_AGE_MS=180000
TRIP_PICKUP_RADIUS_M=750
TRIP_DROPOFF_RADIUS_M=1500
TRIP_MIN_DURATION_SECONDS=30

# Dual GPS tracking. Fresh vehicle IoT data is preferred on an active-trip
# map; the driver's smartphone remains the booking/dispatch source and
# automatic tracking fallback. Trackers may backfill locally buffered points.
IOT_PRIMARY_TTL_MS=45000
IOT_MAX_BACKFILL_AGE_HOURS=168

# Internal GIS Intelligence service. Keep the token server-side and use the
# same value when starting artifacts/gis-service (minimum 32 characters).
GIS_SERVICE_URL=http://127.0.0.1:5100
GIS_SERVICE_TOKEN=
GIS_SERVICE_PORT=5100

# Comma-separated list of origins allowed to call this API (dashboard, mobile
# web build, etc). Required in production — CORS is denied by default when
# unset, rather than reflecting any origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Number of trusted reverse-proxy hops. Keep 0 for direct/ngrok testing; use 1
# only when one trusted nginx or load balancer sits in front of this process.
TRUST_PROXY_HOPS=0

# Tuning (optional, sane defaults applied if unset)
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
PASSWORD_HASH_CONCURRENCY=2

LOG_LEVEL=info

# Operational reports use Philippine local calendar days.
REPORTING_TIME_ZONE=Asia/Manila
REPORTING_UTC_OFFSET=+08:00

# Public loop positions older than this are omitted.
PUBLIC_VEHICLE_LOCATION_TTL_MS=300000

# The initial pilot remains point-to-point. Keep public website wording,
# fare rules, and mobile UI aligned with this value.
PILOT_BOOKING_MODE=point_to_point
