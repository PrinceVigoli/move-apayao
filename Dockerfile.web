FROM node:22.23.1-slim AS build
RUN corepack enable
WORKDIR /repo

ARG APP_FILTER
ARG APP_DIR
ARG BUILD_SCRIPT=build
ARG VITE_API_URL
ARG VITE_SITE_URL
ARG VITE_PRODUCT_URL
ARG VITE_DOCUMENTATION_URL
ARG VITE_GOOGLE_MAPS_BROWSER_API_KEY
ARG VITE_SERVICE_OPERATOR
ARG VITE_SUPPORT_EMAIL
ARG VITE_PRIVACY_EMAIL
ARG VITE_SUPPORT_PHONE
ARG VITE_OFFICE_ADDRESS
ARG VITE_SUPPORT_HOURS
ARG VITE_PASSENGER_ANDROID_URL
ARG VITE_DRIVER_ANDROID_URL
ARG VITE_STORES_LIVE=false

ENV VITE_API_URL=$VITE_API_URL \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_PRODUCT_URL=$VITE_PRODUCT_URL \
    VITE_DOCUMENTATION_URL=$VITE_DOCUMENTATION_URL \
    VITE_GOOGLE_MAPS_BROWSER_API_KEY=$VITE_GOOGLE_MAPS_BROWSER_API_KEY \
    VITE_SERVICE_OPERATOR=$VITE_SERVICE_OPERATOR \
    VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL \
    VITE_PRIVACY_EMAIL=$VITE_PRIVACY_EMAIL \
    VITE_SUPPORT_PHONE=$VITE_SUPPORT_PHONE \
    VITE_OFFICE_ADDRESS=$VITE_OFFICE_ADDRESS \
    VITE_SUPPORT_HOURS=$VITE_SUPPORT_HOURS \
    VITE_PASSENGER_ANDROID_URL=$VITE_PASSENGER_ANDROID_URL \
    VITE_DRIVER_ANDROID_URL=$VITE_DRIVER_ANDROID_URL \
    VITE_STORES_LIVE=$VITE_STORES_LIVE

COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "$APP_FILTER" run "$BUILD_SCRIPT"
RUN mkdir -p /site && cp -R "$APP_DIR/dist/." /site/

FROM caddy:2.10-alpine
COPY deploy/static.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /site /srv
EXPOSE 8080
